DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Cloudflare Turnstile (bot check on login & sign-up) — https://dash.cloudflare.com/?to=/:account/turnstile
# Leave empty in development to use Cloudflare's always-pass test keys. REQUIRED in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google sign-in ("Continue with Google") — Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID (Web application). Authorized redirect URIs:
#   http://localhost:3000/auth/google/callback
#   https://tok-scan.store/auth/google/callback
#   https://tok-scans.vercel.app/auth/google/callback   (Vercel preview address, optional)
# Leave empty to show the Google button as "coming soon".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production address. When set (on Vercel), tok-scans.vercel.app and www.<host> redirect here.
# Set it only AFTER the domain's DNS points to Vercel, then redeploy. Leave empty locally.
CANONICAL_HOST=
