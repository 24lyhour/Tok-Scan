{
  "name": "tok-scans",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "super-admin": "cross-env NODE_OPTIONS=--no-deprecation payload run src/modules/platform/scripts/make-super-admin.ts",
    "seed:admin": "cross-env NODE_OPTIONS=--no-deprecation payload run src/modules/platform/scripts/seed-super-admin.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "yarn test:unit && yarn test:int && yarn test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --project int",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.94.2",
    "@payloadcms/next": "3.94.2",
    "@payloadcms/plugin-multi-tenant": "3.94.2",
    "@payloadcms/richtext-lexical": "3.94.2",
    "@payloadcms/storage-vercel-blob": "3.94.2",
    "@payloadcms/translations": "3.94.2",
    "@payloadcms/ui": "3.94.2",
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "payload": "3.94.2",
    "postcss": "^8.5.33",
    "qrcode": "^1.5.4",
    "react": "19.2.9",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vercel": "^67.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@payloadcms/typescript-plugin": "3.94.2",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  }
}
